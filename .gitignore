# Python build artifacts
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# mkdocs build output
site/

# mkdocs staging dir - assembled by the Docs workflow as symlinks to
# the root markdown files. Never committed.
docs/

# macOS
.DS_Store

# Editor / local config
.vscode/
.idea/
.claude/

# Muneem runtime state (installer writes to ~/.muneem/, not here, but guard anyway)
.muneem/
*.log

# Recorded install / runtime traces. These capture real meeting transcripts,
# window titles, and other PII - never commit.
muneem-traces.txt
*.trace
traces/
